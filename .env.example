# Alpaca Paper Trading API
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# LM Studio (OpenAI-compatible API). Host may omit /v1 — it is appended automatically.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Required if LM Studio has "Require API key" enabled (Developer → API Keys).
# You can use either variable; LM_API_TOKEN is the name LM Studio shows in docs.
LM_STUDIO_API_KEY=
# LM_API_TOKEN=
LM_STUDIO_MODEL=google/gemma-4-e4b

# Dashboard-only: set to 0/false/no to disable debug + hot reload (run.py uses --no-debug instead)
# DASH_DEBUG=1
